{
  "interval": 600,
  "language": "en",
  "backup_dir": "../code-saver-backups",
  "log": "../code-saver.log",
  "excluded_dirs": [
    ".git",
    "__pycache__",
    "venv",
    ".venv",
    "env",
    ".env",
    ".tox",
    ".mypy_cache"
  ],
  "exclude_ext": [],
  "exclude_patterns": ["*.tmp", "*.log", "temp_*"],
  "compress": false,
  "max_size": null,
  "keep_last": null,
  "keep_days": null,
  "follow_symlinks": false,
  "use_gitignore": true
}
